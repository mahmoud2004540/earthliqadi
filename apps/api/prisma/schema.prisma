  totalShares Decimal  @map("total_shares") @db.Decimal(38, 0)
  ppsE18      Decimal  @map("pps_e18") @db.Decimal(78, 0)

  vault LeaderVault @relation(fields: [vaultId], references: [id], onDelete: Restrict)

  @@id([vaultId, at])
  @@map("vault_snapshots")
}

/// TWAP / iceberg parent order (ADR-0020); children are ordinary orders.
model AlgoOrder {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  marketId        String    @map("market_id") @db.Uuid
  kind            String    @db.VarChar(8)
  side            OrderSide
  totalLots       BigInt    @map("total_lots")
  sliceLots       BigInt    @map("slice_lots")
  priceTicks      BigInt?   @map("price_ticks")
  intervalSeconds Int?      @map("interval_seconds")
  /// Trailing stop (ADR-0025): retrace that triggers it, and the protection band of its order.
  callbackBps     Int?      @map("callback_bps")
  slippageBps     Int?      @map("slippage_bps")
  activationTicks BigInt?   @map("activation_ticks")
  /// Best reference price seen since activation (peak for sells, trough for buys).
  extremeTicks    BigInt?   @map("extreme_ticks")
  activated       Boolean   @default(false)
  /// Grid (ADR-0025).
  gridLowerTicks  BigInt?   @map("grid_lower_ticks")
  gridUpperTicks  BigInt?   @map("grid_upper_ticks")
  gridCount       Int?      @map("grid_count")
  gridDirection   String?   @map("grid_direction") @db.VarChar(8)
  /// Listed in the grid marketplace.
  isPublic        Boolean   @default(false) @map("is_public")
  copiedFromId    String?   @map("copied_from_id") @db.Uuid
  reduceOnly      Boolean   @default(false) @map("reduce_only")
  status          String    @default("RUNNING") @db.VarChar(10)
  slicesSent      Int       @default(0) @map("slices_sent")
  nextAt          DateTime  @map("next_at") @db.Timestamptz(3)
  lastError       String?   @map("last_error") @db.VarChar(256)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([userId, createdAt], map: "algo_orders_user_idx")
  @@map("algo_orders")
}

/// Accounts allowed to answer RFQs (ADR-0020).
