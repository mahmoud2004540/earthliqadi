  amount        Decimal          @db.Decimal(38, 0)
  afterState    BigInt           @map("after_state")
  expiry        DateTime         @db.Timestamptz(3)
  signature     String           @db.Char(132)
  status        WithdrawalStatus @default(SIGNED)
  txHash        String?          @map("tx_hash") @db.Char(66)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  finalisedAt   DateTime?        @map("finalised_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status, expiry])
  @@map("withdrawals")
}

model VaultState {
  chainId       Int              @map("chain_id")
  vaultAddress  String           @map("vault_address") @db.Char(42)
  index         BigInt
  root          String           @db.Char(66)
  lastDepositId BigInt           @map("last_deposit_id")
  leafCount     Int              @map("leaf_count")
  status        VaultStateStatus @default(PENDING)
  txHash        String?          @map("tx_hash") @db.Char(66)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  committedAt   DateTime?        @map("committed_at") @db.Timestamptz(3)

  leaves VaultStateLeaf[]

  @@id([chainId, vaultAddress, index])
  @@map("vault_states")
}

/// Append-only.
model VaultStateLeaf {
  chainId       Int     @map("chain_id")
  vaultAddress  String  @map("vault_address") @db.Char(42)
  index         BigInt
  walletAddress String  @map("wallet_address") @db.Char(42)
  tokenAddress  String  @map("token_address") @db.Char(42)
  balance       Decimal @db.Decimal(78, 0)

  state VaultState @relation(fields: [chainId, vaultAddress, index], references: [chainId, vaultAddress, index], onDelete: Restrict, map: "vault_state_leaves_state_fkey")

  @@id([chainId, vaultAddress, index, walletAddress, tokenAddress])
  @@map("vault_state_leaves")
}

/// Agent API key (ADR-0017): Ed25519 public key authorised by a wallet signature.
model ApiKey {
  id                     String    @id @db.Uuid
  userId                 String    @map("user_id") @db.Uuid
  label                  String    @db.VarChar(48)
  /// Hex-encoded raw Ed25519 public key (32 bytes).
  publicKey              String    @unique @map("public_key") @db.Char(64)
  /// Subset of {read, trade}. No scope can withdraw.
  scopes                 String[]
  allowedIps             String[]  @default([]) @map("allowed_ips")
  authorizationMessage   String    @map("authorization_message")
  authorizationSignature String    @map("authorization_signature") @db.VarChar(132)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz(3)
  lastUsedAt             DateTime? @map("last_used_at") @db.Timestamptz(3)
  revokedAt              DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("api_keys")
}

/// Dead-man switch: cancel every open order when the deadline passes.
model CancelAllTimer {
  userId    String   @id @map("user_id") @db.Uuid
  deadline  DateTime @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([deadline])
  @@map("cancel_all_timers")
}

/// Public fee schedule (ADR-0018): discounts on market base fees by 30-day volume.
model FeeTier {
  tier             Int      @id
  minVolume        Decimal  @map("min_volume") @db.Decimal(38, 0)
  takerDiscountBps Int      @map("taker_discount_bps")
  makerDiscountBps Int      @map("maker_discount_bps")
  updatedAt        DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@map("fee_tiers")
}

model UserFeeTier {
  userId     String   @id @map("user_id") @db.Uuid
  tier       Int
  volume30d  Decimal  @map("volume_30d") @db.Decimal(38, 0)
  computedAt DateTime @map("computed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_fee_tiers")
}

model ReferralCode {
  code      String   @id @db.VarChar(16)
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("referral_codes")
}

/// Maker rebates and referral payouts, each funded by the taker fee of one trade.
model FeePayout {
  id           BigInt   @id @default(autoincrement())
  tradeKey     String   @map("trade_key") @db.VarChar(128)
  kind         String   @db.VarChar(16)
  userId       String   @map("user_id") @db.Uuid
  sourceUserId String   @map("source_user_id") @db.Uuid
  assetId      String   @map("asset_id") @db.Uuid
  amount       Decimal  @db.Decimal(38, 0)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([tradeKey, kind], map: "fee_payouts_trade_kind_key")
  @@index([userId, createdAt])
  @@map("fee_payouts")
}

/// Activity points per account and UTC day (ADR-0018). Not a token.
model UserPoints {
  userId         String   @map("user_id") @db.Uuid
  day            DateTime @db.Date
  points         Decimal  @db.Decimal(38, 0)
  excludedVolume Decimal  @default(0) @map("excluded_volume") @db.Decimal(38, 0)
  computedAt     DateTime @map("computed_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, day])
  @@map("user_points")
}

/// Leader vault (ADR-0019): a leader trades followers' pooled collateral.
model LeaderVault {
  id                String   @id @db.Uuid
  leaderUserId      String   @map("leader_user_id") @db.Uuid
  accountUserId     String   @unique @map("account_user_id") @db.Uuid
  name              String   @db.VarChar(48)
  description       String   @default("") @db.VarChar(280)
  quoteAssetId      String   @map("quote_asset_id") @db.Uuid
  profitShareBps    Int      @map("profit_share_bps")
  minLeaderShareBps Int      @default(500) @map("min_leader_share_bps")
  maxLeverage       Int      @map("max_leverage")
  maxDrawdownBps    Int      @map("max_drawdown_bps")
  status            String   @default("OPEN") @db.VarChar(12)
  peakPpsE18        Decimal  @map("peak_pps_e18") @db.Decimal(78, 0)
