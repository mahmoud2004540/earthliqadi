// Phase 1: identity, sessions, RBAC and audit. Phase 2: double-entry ledger.
// Orders, markets and custody tables arrive in later phases.
// Naming: models are PascalCase, tables/columns are snake_case via @@map/@map.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountType {
  INDIVIDUAL
  INSTITUTIONAL
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ActorType {
  USER
  STAFF
  SYSTEM
  ANONYMOUS
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id                    String      @id @default(uuid()) @db.Uuid
  /// Normalised (trimmed, lower-cased) email.
  email                 String?     @unique @db.VarChar(254)
  /// Null for wallet-only accounts (ADR-0013).
  passwordHash          String?     @map("password_hash")
  /// Lower-case Ethereum address for Sign-In with Ethereum accounts. Immutable.
  walletAddress         String?     @unique @map("wallet_address") @db.Char(42)
  status                UserStatus  @default(PENDING_VERIFICATION)
  accountType           AccountType @default(INDIVIDUAL) @map("account_type")
  /// Sub-account (ADR-0017): owned by this parent wallet account; no credentials of its own.
  parentUserId          String?     @map("parent_user_id") @db.Uuid
  /// Sub-accounts only.
  label                 String?     @db.VarChar(48)
  /// Set once at account creation from a referral code (ADR-0018).
  referredByUserId      String?     @map("referred_by_user_id") @db.Uuid
  /// Trading account of a leader vault (ADR-0019).
  isVault               Boolean     @default(false) @map("is_vault")
  /// Perpetuals: "isolated" (default) or "cross" (free balance tops up positions, ADR-0021).
  perpMarginMode        String      @default("isolated") @map("perp_margin_mode") @db.VarChar(8)
  /// Multi-collateral (ADR-0027): pledged balances may be sold to defend cross positions.
  perpCollateralEnabled Boolean     @default(false) @map("perp_collateral_enabled")
  /// Terms-of-use version the account accepted, and when (ADR-0022).
  termsAcceptedVersion  String?     @map("terms_accepted_version") @db.VarChar(32)
  termsAcceptedAt       DateTime?   @map("terms_accepted_at") @db.Timestamptz(3)
  emailVerifiedAt       DateTime?   @map("email_verified_at") @db.Timestamptz(3)

  /// AES-256-GCM encrypted TOTP secret (iv|tag|ciphertext). Never returned by the API.
  mfaTotpSecretEnc  Bytes?    @map("mfa_totp_secret_enc")
  /// Secret generated during enrolment, promoted to mfaTotpSecretEnc once confirmed.
  mfaTotpPendingEnc Bytes?    @map("mfa_totp_pending_enc")
  mfaEnabledAt      DateTime? @map("mfa_enabled_at") @db.Timestamptz(3)
  /// Last accepted TOTP time-step; prevents code replay.
  mfaLastUsedStep   BigInt?   @map("mfa_last_used_step")

  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions           Session[]
  parent             User?               @relation("SubAccounts", fields: [parentUserId], references: [id], onDelete: Restrict)
  subAccounts        User[]              @relation("SubAccounts")
  referredBy         User?               @relation("Referrals", fields: [referredByUserId], references: [id], onDelete: Restrict)
  referrals          User[]              @relation("Referrals")
  referralCode       ReferralCode?
  feeTier            UserFeeTier?
  points             UserPoints[]
  apiKeys            ApiKey[]
  cancelAllTimer     CancelAllTimer?
  tokens             VerificationToken[]
  roles              UserRole[]          @relation("UserRoles")
  grantedRoles       UserRole[]          @relation("RoleGrants")
  ledgerAccounts     LedgerAccount[]
  orders             Order[]
  positions          Position[]
  /// 0 = none, 1 = basic identity verified, 2 = enhanced (ADR-0012).
  kycLevel           Int                 @default(0) @map("kyc_level")
  approvalsRequested ApprovalRequest[]   @relation("ApprovalRequester")
  approvalsDecided   ApprovalRequest[]   @relation("ApprovalDecider")
  kycCases           KycCase[]           @relation("KycSubject")
  kycReviews         KycCase[]           @relation("KycReviewer")
  notifications      Notification[]
  supportTickets     SupportTicket[]
  supportMessages    SupportMessage[]
  announcements      Announcement[]
  chainDeposits      ChainDeposit[]
  withdrawals        Withdrawal[]

  @@map("users")
}

model Session {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  /// SHA-256 of the opaque session token. The raw token only exists in the client cookie.
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  ipAddress     String?   @map("ip_address") @db.VarChar(64)
  userAgent     String?   @map("user_agent") @db.VarChar(512)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  /// Absolute expiry; idle expiry is derived from lastSeenAt.
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(64)
  /// Last fresh authenticator check in this session (step-up for sensitive staff actions).
  stepUpAt      DateTime? @map("step_up_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@map("sessions")
}

model VerificationToken {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @map("user_id") @db.Uuid
  purpose    TokenPurpose
  /// SHA-256 of the opaque token sent by email.
  tokenHash  String       @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(64)
  name        String   @db.VarChar(128)
  description String
  isStaff     Boolean  @default(false) @map("is_staff")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.VarChar(64)
  description String

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  grantedAt   DateTime @default(now()) @map("granted_at") @db.Timestamptz(3)
  /// Null when granted by the system (registration default) or the audited CLI.
  grantedById String?  @map("granted_by_id") @db.Uuid

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrants", fields: [grantedById], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Append-only. UPDATE/DELETE/TRUNCATE are blocked by a database trigger (see migration).
model AuditLog {
  id          BigInt       @id @default(autoincrement())
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType   ActorType    @map("actor_type")
  actorUserId String?      @map("actor_user_id") @db.Uuid
  action      String       @db.VarChar(96)
  outcome     AuditOutcome
  targetType  String?      @map("target_type") @db.VarChar(64)
  targetId    String?      @map("target_id") @db.VarChar(128)
  ipAddress   String?      @map("ip_address") @db.VarChar(64)
  userAgent   String?      @map("user_agent") @db.VarChar(512)
  requestId   String?      @map("request_id") @db.VarChar(64)
  /// Non-sensitive structured context. Never store secrets, tokens or passwords here.
  metadata    Json         @default("{}")

  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Phase 2: double-entry ledger (see docs/decisions/0006-double-entry-ledger.md)
// Amounts are integer minor units in NUMERIC(38,0); never floating point.
// Invariants (balanced entries, immutability, balance projection, non-negative
// balances) are enforced by database triggers/constraints in the migration.
// ---------------------------------------------------------------------------

enum AssetStatus {
  ACTIVE
  DISABLED
}

enum LedgerAccountType {
  USER_AVAILABLE
  USER_LOCKED
  FEE_REVENUE
  SUSPENSE
  SIMULATED_CUSTODY
  /// Paper trading only: source of faucet grants for paper assets (ADR-0010).
  PAPER_FAUCET
  /// Perpetuals (ADR-0011, paper only): isolated position margin, per user and asset.
  USER_MARGIN
  /// Perpetuals: counterparty of realised PnL; balance = Σ open entry notional.
  PERP_CLEARING
  /// Perpetuals: receives liquidation fees, covers bankrupt positions.
  INSURANCE_FUND
  /// Perpetuals: funding is collected into and paid out of this pool.
  PERP_FUNDING_POOL
  /// Mirror of tokens held by the on-chain vault (ADR-0014). Debit-normal.
  VAULT_CUSTODY
  /// User funds reserved for a signed, not yet executed vault withdrawal.
  USER_WITHDRAWING
}

enum PostingDirection {
  DEBIT
  CREDIT
}

enum JournalEntryType {
  SIMULATED_DEPOSIT
  BALANCE_HOLD
  BALANCE_RELEASE
  REVERSAL
  TRADE
  PAPER_FAUCET_GRANT
  MARGIN_TRANSFER
  FUNDING
  INSURANCE_FUND_SEED
  CHAIN_DEPOSIT
  WITHDRAWAL_HOLD
  WITHDRAWAL_FINAL
  WITHDRAWAL_RELEASE
  INTERNAL_TRANSFER
  VAULT_DEPOSIT
  VAULT_REDEMPTION
}

enum ReconciliationStatus {
  OK
  MISMATCH
}

enum ReconciliationTrigger {
  SCHEDULED
  MANUAL
  CLI
}

model Asset {
  id                String      @id @default(uuid()) @db.Uuid
  /// Upper-case ticker-like code, unique (e.g. BTC). Not a listing claim.
  code              String      @unique @db.VarChar(16)
  name              String      @db.VarChar(64)
  /// Number of decimal places of the minor unit (BTC = 8, ETH = 18).
  scale             Int
  status            AssetStatus @default(ACTIVE)
  /// Paper (simulated) asset: may never share a journal entry or market with real assets (ADR-0010). Immutable.
  isPaper           Boolean     @default(false) @map("is_paper")
  /// Paper assets only: amount (minor units) granted per faucet request.
  faucetAmount      Decimal?    @map("faucet_amount") @db.Decimal(38, 0)
  /// Lower-case ERC-20 address held by the vault (real assets only; ADR-0014). Immutable.
  chainTokenAddress String?     @unique @map("chain_token_address") @db.Char(42)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts      LedgerAccount[]
  postings      Posting[]
  baseMarkets   Market[]        @relation("MarketBase")
  quoteMarkets  Market[]        @relation("MarketQuote")
  heldByOrders  Order[]
  chainDeposits ChainDeposit[]
  withdrawals   Withdrawal[]

  @@map("assets")
}

model LedgerAccount {
  id            String            @id @default(uuid()) @db.Uuid
  assetId       String            @map("asset_id") @db.Uuid
  type          LedgerAccountType
  ownerUserId   String?           @map("owner_user_id") @db.Uuid
  /// owner_user_id as text, or 'system'. Makes (asset, type, owner) uniquely addressable.
  ownerKey      String            @map("owner_key") @db.VarChar(36)
  normalSide    PostingDirection  @map("normal_side")
  allowNegative Boolean           @default(false) @map("allow_negative")
  /// Projection maintained ONLY by the posting trigger. Minor units.
  balance       Decimal           @default(0) @db.Decimal(38, 0)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  asset    Asset     @relation(fields: [assetId], references: [id], onDelete: Restrict)
  owner    User?     @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  postings Posting[]

  @@unique([assetId, type, ownerKey])
  @@index([ownerUserId])
  @@map("ledger_accounts")
}

/// Immutable. Corrections are new entries (reversals), never edits.
model JournalEntry {
  id              BigInt           @id @default(autoincrement())
  type            JournalEntryType
  idempotencyKey  String           @unique @map("idempotency_key") @db.VarChar(128)
  /// SHA-256 of the canonical request; detects key reuse with a different payload.
  fingerprint     String           @db.Char(64)
  description     String           @db.VarChar(256)
  reversesEntryId BigInt?          @unique @map("reverses_entry_id")
  actorType       ActorType        @map("actor_type")
  actorUserId     String?          @map("actor_user_id") @db.Uuid
  requestId       String?          @map("request_id") @db.VarChar(64)
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  reverses   JournalEntry? @relation("Reversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy JournalEntry? @relation("Reversal")
  postings   Posting[]

  @@index([type, createdAt])
  @@map("journal_entries")
}

/// Immutable.
model Posting {
  id        BigInt           @id @default(autoincrement())
  entryId   BigInt           @map("entry_id")
  accountId String           @map("account_id") @db.Uuid
  /// Denormalised from the account (checked by trigger) for per-asset balancing.
  assetId   String           @map("asset_id") @db.Uuid
  direction PostingDirection
  amount    Decimal          @db.Decimal(38, 0)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  entry   JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Restrict)
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  asset   Asset         @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId, id])
  @@map("postings")
}

/// Append-only record of every reconciliation run.
model LedgerReconciliationRun {
  id              String                @id @default(uuid()) @db.Uuid
  trigger         ReconciliationTrigger
  status          ReconciliationStatus
  startedAt       DateTime              @map("started_at") @db.Timestamptz(3)
  finishedAt      DateTime              @map("finished_at") @db.Timestamptz(3)
  accountsChecked Int                   @map("accounts_checked")
  entriesChecked  Int                   @map("entries_checked")
  /// Structured list of discrepancies (empty when OK).
  findings        Json                  @default("[]")
  actorUserId     String?               @map("actor_user_id") @db.Uuid

  @@index([startedAt])
  @@map("ledger_reconciliation_runs")
}

// ---------------------------------------------------------------------------
// Phase 3: markets, orders, engine log and settlement (ADR-0007)
// Prices are integer ticks, quantities integer lots. Money stays in the ledger.
// ---------------------------------------------------------------------------

enum MarketKind {
  SPOT
  PERPETUAL
}

enum PositionStatus {
  NORMAL
  LIQUIDATING
}

enum MarketStatus {
  ACTIVE
  HALTED
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
  STOP_LIMIT
  STOP_MARKET
}

enum TimeInForce {
  GTC
  IOC
  FOK
  POST_ONLY
}

enum OrderStatus {
  PENDING_NEW
  PENDING_TRIGGER
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}

model Market {
  id              String       @id @default(uuid()) @db.Uuid
  /// e.g. BTC-USDT
  symbol          String       @unique @db.VarChar(40)
  baseAssetId     String       @map("base_asset_id") @db.Uuid
  quoteAssetId    String       @map("quote_asset_id") @db.Uuid
  /// Quote minor units per one whole base unit, per price tick.
  tickSize        Decimal      @map("tick_size") @db.Decimal(38, 0)
  /// Base minor units per quantity lot.
  lotSize         Decimal      @map("lot_size") @db.Decimal(38, 0)
  minQuantityLots BigInt       @default(1) @map("min_quantity_lots")
  makerFeeBps     Int          @map("maker_fee_bps")
  takerFeeBps     Int          @map("taker_fee_bps")
  status          MarketStatus @default(ACTIVE)
  /// Paper market: both assets are paper assets (DB-enforced). Immutable.
  isPaper         Boolean      @default(false) @map("is_paper")
  /// SPOT or PERPETUAL (perpetuals are paper-only, DB-enforced). Immutable.
  kind            MarketKind   @default(SPOT)
  /// Perpetual risk parameters (validated on write; ADR-0011). Null for spot.
  perpConfig      Json?        @map("perp_config")
  /// Gap-free per-market command counter (row lock orders commits; ADR-0007).
  nextCommandSeq  BigInt       @default(0) @map("next_command_seq")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  baseAsset     Asset              @relation("MarketBase", fields: [baseAssetId], references: [id], onDelete: Restrict)
  quoteAsset    Asset              @relation("MarketQuote", fields: [quoteAssetId], references: [id], onDelete: Restrict)
  orders        Order[]
  trades        Trade[]
  positions     Position[]
  priceSamples  PerpPriceSample[]
  fundingRounds PerpFundingRound[]
  perpState     PerpMarketState?

  @@map("markets")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  marketId          String      @map("market_id") @db.Uuid
  /// Client-supplied idempotency key, unique per user.
  clientOrderId     String      @map("client_order_id") @db.VarChar(64)
  side              OrderSide
  type              OrderType
  timeInForce       TimeInForce @map("time_in_force")
  priceTicks        BigInt?     @map("price_ticks")
  stopPriceTicks    BigInt?     @map("stop_price_ticks")
  /// Stop orders: 'above' | 'below'; null = classic stop direction.
  triggerDirection  String?     @map("trigger_direction") @db.VarChar(5)
  /// Take-profit / stop-loss pair: when one triggers, the other is cancelled.
  ocoGroupId        String?     @map("oco_group_id") @db.Uuid
  /// Self-trade-prevention account sent to the engine (null on older rows = user id).
  engineAccount     String?     @map("engine_account") @db.Uuid
  /// Child of an algo order (TWAP, iceberg, chase, trailing stop, grid; ADR-0020, ADR-0025).
  algoOrderId       String?     @map("algo_order_id") @db.Uuid
  /// Left out of the public order book (ADR-0025); limit GTC/post-only only.
  hidden            Boolean     @default(false)
  /// Grid children: the grid level the order sits on.
  gridLevel         Int?        @map("grid_level") @db.SmallInt
  quantityLots      BigInt      @map("quantity_lots")
  filledLots        BigInt      @default(0) @map("filled_lots")
  status            OrderStatus @default(PENDING_NEW)
  holdAssetId       String      @map("hold_asset_id") @db.Uuid
  /// Funds held when the order was placed (minor units of the hold asset).
  holdAmount        Decimal     @map("hold_amount") @db.Decimal(38, 0)
  /// Portion of the hold not yet consumed by fills or released.
  lockedRemaining   Decimal     @map("locked_remaining") @db.Decimal(38, 0)
  rejectReason      String?     @map("reject_reason") @db.VarChar(48)
  cancelReason      String?     @map("cancel_reason") @db.VarChar(48)
  cancelRequestedAt DateTime?   @map("cancel_requested_at") @db.Timestamptz(3)
  /// Perpetuals: may only reduce the position.
  reduceOnly        Boolean     @default(false) @map("reduce_only")
  /// Perpetuals: placed by the liquidation engine (no hold; ADR-0011).
  isLiquidation     Boolean     @default(false) @map("is_liquidation")
  /// Perpetuals: leverage the order's margin was held at.
  leverage          Int?
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  market    Market @relation(fields: [marketId], references: [id], onDelete: Restrict)
  holdAsset Asset  @relation(fields: [holdAssetId], references: [id], onDelete: Restrict)

  @@unique([userId, clientOrderId])
  @@index([userId, createdAt])
  @@index([marketId, status])
  @@index([algoOrderId], map: "orders_algo_order_idx")
  @@map("orders")
}

/// Immutable record of every fill (written by settlement).
model Trade {
  id             String    @id @default(uuid()) @db.Uuid
  marketId       String    @map("market_id") @db.Uuid
  eventSeq       BigInt    @map("event_seq")
  makerOrderId   String    @map("maker_order_id") @db.Uuid
  takerOrderId   String    @map("taker_order_id") @db.Uuid
  buyerUserId    String    @map("buyer_user_id") @db.Uuid
  sellerUserId   String    @map("seller_user_id") @db.Uuid
  takerSide      OrderSide @map("taker_side")
  priceTicks     BigInt    @map("price_ticks")
  quantityLots   BigInt    @map("quantity_lots")
  baseAmount     Decimal   @map("base_amount") @db.Decimal(38, 0)
  quoteAmount    Decimal   @map("quote_amount") @db.Decimal(38, 0)
  buyerFee       Decimal   @map("buyer_fee") @db.Decimal(38, 0)
  sellerFee      Decimal   @map("seller_fee") @db.Decimal(38, 0)
  journalEntryId BigInt    @map("journal_entry_id")
  /// When the engine produced the fill (engine event timestamp), used for candles.
  executedAt     DateTime  @map("executed_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([marketId, eventSeq])
  @@index([marketId, executedAt])
  @@index([buyerUserId, createdAt])
  @@index([sellerUserId, createdAt])
  @@map("trades")
}

/// Durable, gap-free, immutable command log (written by the API).
model EngineCommand {
  marketId  String   @map("market_id") @db.Uuid
  seq       BigInt
  kind      String   @db.VarChar(16)
  payload   Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([marketId, seq])
  @@map("engine_commands")
}

/// Immutable event log (written only by the matching engine).
model EngineEvent {
  marketId   String   @map("market_id") @db.Uuid
  seq        BigInt
  commandSeq BigInt   @map("command_seq")
  type       String   @db.VarChar(32)
  payload    Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([marketId, seq])
  @@map("engine_events")
}

/// Engine offsets and state hash per market (written only by the engine).
model EngineMarketState {
  marketId       String   @id @map("market_id") @db.Uuid
  lastCommandSeq BigInt   @map("last_command_seq")
  lastEventSeq   BigInt   @map("last_event_seq")
  stateHash      String   @map("state_hash") @db.Char(64)
  updatedAt      DateTime @map("updated_at") @db.Timestamptz(3)

  @@map("engine_market_state")
}

/// Settlement offset per market (written by the API settlement worker).
model SettlementState {
  marketId     String   @id @map("market_id") @db.Uuid
  lastEventSeq BigInt   @default(0) @map("last_event_seq")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("settlement_state")
}

// ---------------------------------------------------------------------------
// Phase 6: perpetual futures, paper only (ADR-0011)
// ---------------------------------------------------------------------------

/// One isolated-margin position per user and perpetual market.
model Position {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  marketId      String         @map("market_id") @db.Uuid
  /// Signed lots: positive = long.
  sizeLots      BigInt         @default(0) @map("size_lots")
  /// Signed entry notional (quote minor units), same sign as the size.
  entryNotional Decimal        @default(0) @map("entry_notional") @db.Decimal(38, 0)
  /// Isolated margin (quote minor units); Σ per user = USER_MARGIN balance.
  margin        Decimal        @default(0) @db.Decimal(38, 0)
  leverage      Int
  status        PositionStatus @default(NORMAL)
  realizedPnl   Decimal        @default(0) @map("realized_pnl") @db.Decimal(38, 0)
  fundingPnl    Decimal        @default(0) @map("funding_pnl") @db.Decimal(38, 0)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)
  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([userId, marketId])
  @@index([marketId, sizeLots])
  @@map("positions")
}

/// Append-only index/mark history (quote minor units per whole base unit).
model PerpPriceSample {
  marketId    String   @map("market_id") @db.Uuid
  sampledAt   DateTime @map("sampled_at") @db.Timestamptz(3)
  indexPrice  Decimal  @map("index_price") @db.Decimal(38, 0)
  markPrice   Decimal  @map("mark_price") @db.Decimal(38, 0)
  midPrice    Decimal? @map("mid_price") @db.Decimal(38, 0)
  /// Premium of the book mid over the index, 1e-8 units.
  premiumRate BigInt?  @map("premium_rate")
  sourcesUsed Int      @map("sources_used")

  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@id([marketId, sampledAt])
  @@map("perp_price_samples")
}

model PerpMarketState {
  marketId        String    @id @map("market_id") @db.Uuid
  basisEma        Decimal   @default(0) @map("basis_ema") @db.Decimal(38, 0)
  /// Simulated index sources' last prices (development/paper only, labelled).
  simulatedPrices Json      @default("{}") @map("simulated_prices")
  lastFundingAt   DateTime? @map("last_funding_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@map("perp_market_state")
}

/// Append-only record of every funding settlement.
model PerpFundingRound {
  id             String   @id @default(uuid()) @db.Uuid
  marketId       String   @map("market_id") @db.Uuid
  fundingTime    DateTime @map("funding_time") @db.Timestamptz(3)
  /// 1e-8 units; positive = longs pay shorts.
  rate           BigInt
  markPrice      Decimal  @map("mark_price") @db.Decimal(38, 0)
  collected      Decimal  @db.Decimal(38, 0)
  distributed    Decimal  @db.Decimal(38, 0)
  positions      Int
  journalEntryId BigInt?  @map("journal_entry_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  market Market @relation(fields: [marketId], references: [id], onDelete: Restrict)

  @@unique([marketId, fundingTime])
  @@map("perp_funding_rounds")
}

// ---------------------------------------------------------------------------
// Phase 7: admin, compliance and support (ADR-0012)
// ---------------------------------------------------------------------------

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFO
}

enum TicketStatus {
  OPEN
  WAITING_ON_USER
  CLOSED
}

/// Maker-checker request: executed only when a DIFFERENT staff member approves (DB-enforced).
model ApprovalRequest {
  id            String         @id @default(uuid()) @db.Uuid
  action        String         @db.VarChar(48)
  payload       Json
  reason        String         @db.VarChar(256)
  status        ApprovalStatus @default(PENDING)
  requestedById String         @map("requested_by_id") @db.Uuid
  requestedAt   DateTime       @default(now()) @map("requested_at") @db.Timestamptz(3)
  expiresAt     DateTime       @map("expires_at") @db.Timestamptz(3)
  decidedById   String?        @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?      @map("decided_at") @db.Timestamptz(3)
  decisionNote  String?        @map("decision_note") @db.VarChar(256)
  result        Json?

  requestedBy User  @relation("ApprovalRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, requestedAt])
  @@map("approval_requests")
}

model KycCase {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  level        Int
  status       KycStatus @default(PENDING)
  /// AES-256-GCM encrypted JSON profile. Never logged or returned in lists.
  profileEnc   Bytes     @map("profile_enc")
  countryCode  String    @map("country_code") @db.Char(2)
  screening    Json
  reviewerId   String?   @map("reviewer_id") @db.Uuid
  decisionNote String?   @map("decision_note") @db.VarChar(512)
  submittedAt  DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt    DateTime? @map("decided_at") @db.Timestamptz(3)

  user     User  @relation("KycSubject", fields: [userId], references: [id], onDelete: Restrict)
  reviewer User? @relation("KycReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([status, submittedAt])
  @@index([userId])
  @@map("kyc_cases")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  kind      String    @db.VarChar(48)
  title     String    @db.VarChar(160)
  body      String    @db.VarChar(1000)
  data      Json      @default("{}")
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("notifications")
}

model SupportTicket {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  subject   String       @db.VarChar(160)
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  messages SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId])
  @@map("support_tickets")
}

/// Append-only.
model SupportMessage {
  id        String   @id @default(uuid()) @db.Uuid
  ticketId  String   @map("ticket_id") @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  fromStaff Boolean  @map("from_staff")
  body      String   @db.VarChar(5000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User          @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
  @@map("support_messages")
}

/// Append-only.
model Announcement {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(160)
  body        String   @db.VarChar(5000)
  createdById String   @map("created_by_id") @db.Uuid
  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(3)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([publishedAt])
  @@map("announcements")
}

// ---------------------------------------------------------------------------
// Phase 8: non-custodial vault on a test chain (ADR-0014)
// ---------------------------------------------------------------------------

enum WithdrawalStatus {
  SIGNED
  EXECUTED
  EXPIRED
}

enum VaultStateStatus {
  PENDING
  COMMITTED
}

model ChainDeployment {
  chainId         Int      @id @map("chain_id")
  vaultAddress    String   @map("vault_address") @db.Char(42)
  operatorAddress String   @map("operator_address") @db.Char(42)
  deployBlock     BigInt   @map("deploy_block")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("chain_deployments")
}

model ChainCursor {
  chainId       Int       @id @map("chain_id")
  lastBlock     BigInt    @map("last_block")
  lastBlockHash String?   @map("last_block_hash") @db.Char(66)
  lastBlockTime DateTime? @map("last_block_time") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("chain_cursors")
}

model ChainDeposit {
  chainId        Int      @map("chain_id")
