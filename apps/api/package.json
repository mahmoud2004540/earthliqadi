{
  "name": "@platform/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "dev": "prisma generate && nest start --watch --exec \"node --env-file-if-exists=../../.env\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.ts",
    "test:integration": "cargo build --quiet --manifest-path ../../services/matching-engine/Cargo.toml --bins && jest --config jest.integration.config.ts --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma migrate dev'",
    "prisma:migrate:deploy": "sh -c 'set -a; [ -f ../../.env ] && . ../../.env; set +a; prisma migrate deploy'",
    "cli:grant-role": "node --env-file-if-exists=../../.env dist/cli/grant-role.js",
    "cli:ledger": "node --env-file-if-exists=../../.env dist/cli/ledger.js"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.7.1",
    "@platform/config": "workspace:*",
    "@platform/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2",
    "jest": "30.5.2",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  }
}
