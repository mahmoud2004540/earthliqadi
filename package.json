{
  "name": "exchange-platform",
  "private": true,
  "description": "Security-first centralized exchange platform monorepo (pre-launch, development only).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=10.28 <11"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:packages": "pnpm --filter './packages/*' run build",
    "dev": "pnpm build:packages && pnpm -r --parallel --filter './apps/*' run dev",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm build:packages && pnpm -r run typecheck",
    "test": "pnpm build:packages && pnpm -r run test",
    "test:integration": "pnpm build:packages && pnpm --filter @platform/api run test:integration",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @platform/api run prisma:migrate:deploy",
    "db:migrate:dev": "pnpm --filter @platform/api run prisma:migrate:dev",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "15.5.28",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
