# ---------------------------------------------------------------------------
# Local development environment. Copy to `.env` (never commit `.env`).
# Values containing "change-me" / "dev-only" are REJECTED by the API when
# DEPLOY_ENV is staging or production.
# Generate real secrets with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

NODE_ENV=development
DEPLOY_ENV=local
LOG_LEVEL=info

# --- Brand (temporary; final brand not chosen) ---
BRAND_NAME=Exchange
NEXT_PUBLIC_BRAND_NAME=Exchange

# --- PostgreSQL ---
POSTGRES_USER=exchange
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=exchange_dev
DATABASE_URL=postgresql://exchange:dev-only-postgres-password@localhost:5432/exchange_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
# Hops between the browser and the API (local: Next.js proxy = 1).
TRUST_PROXY_HOPS=1
# http://localhost cannot use Secure / __Host- cookies. Must be true elsewhere.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
CSRF_SECRET=dev-only-change-me-csrf-secret-at-least-32-chars
# 32 random bytes, base64. Dev-only value below (all zero bytes) - never reuse.
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Development mail transport: verification/reset links are printed to the API log.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@localhost
SWAGGER_ENABLED=true

# --- Web: local `pnpm dev` only (Next.js proxies /api here). Docker uses the edge proxy. ---
API_INTERNAL_URL=http://localhost:4000
