# ---------------------------------------------------------------------------
# Local development environment. Copy to `.env` (never commit `.env`).
# Values containing "change-me" / "dev-only" are REJECTED by the API when
# DEPLOY_ENV is staging or production.
# Generate real secrets with:  openssl rand -base64 32
# ---------------------------------------------------------------------------

NODE_ENV=development
DEPLOY_ENV=local
LOG_LEVEL=info

# --- Brand (temporary; final brand not chosen) ---
BRAND_NAME=Exchange
NEXT_PUBLIC_BRAND_NAME=Exchange

# --- PostgreSQL ---
POSTGRES_USER=exchange
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=exchange_dev
DATABASE_URL=postgresql://exchange:dev-only-postgres-password@localhost:5432/exchange_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:3000
# Hops between the browser and the API (local: Next.js proxy = 1).
TRUST_PROXY_HOPS=1
# http://localhost cannot use Secure / __Host- cookies. Must be true elsewhere.
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
CSRF_SECRET=dev-only-change-me-csrf-secret-at-least-32-chars
# 32 random bytes, base64. Dev-only value below (all zero bytes) - never reuse.
MFA_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Identity (KYC) data at rest; must differ from MFA_ENCRYPTION_KEY. Dev-only value.
PII_ENCRYPTION_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBA=
# Staff permissions require MFA (ADR-0012). Customers sign in with a wallet and no KYC (ADR-0013).
STAFF_MFA_REQUIRED=true
KYC_ENABLED=false
KYC_REQUIRED_FOR_REAL_TRADING=false
# ISO country codes refused at verification and for opening new risk (ADR-0022).
# Legal input required; production refuses to boot with an empty list. Empty in development.
RESTRICTED_COUNTRIES=
# Edge/CDN header carrying the client's country (e.g. cf-ipcountry); the edge must overwrite
# client-sent values. Empty = region checks off (development only).
GEO_COUNTRY_HEADER=
# allow | deny when the country is unknown; must be deny in production.
GEO_UNKNOWN_COUNTRY=allow
# Current terms-of-use version; users accept it before trading.
TERMS_VERSION=draft-1
# Enables GET /metrics on the API (not routed by the edge). Dev-only value; 32+ characters.
METRICS_TOKEN=dev-only-metrics-token-change-me-0123456789
# Development mail transport: verification/reset links are printed to the API log.
MAIL_TRANSPORT=log
MAIL_FROM=no-reply@localhost
SWAGGER_ENABLED=true
# Ledger reconciliation interval in seconds (0 disables the scheduler).
LEDGER_RECONCILIATION_INTERVAL_SECONDS=300
# Settlement worker poll interval for engine events (0 disables).
SETTLEMENT_POLL_MS=250
# Perpetual risk engine tick (index/mark, funding, liquidation); 0 disables.
PERP_RISK_POLL_MS=1000
# Dead-man switch (cancel-after) checks; 0 disables (ADR-0017)
CANCEL_TIMER_POLL_MS=1000
# Fees, referrals, points (ADR-0018)
REFERRAL_FEE_SHARE_BPS=1000
REFERRAL_DURATION_DAYS=365
FEE_VOLUME_QUOTE_ASSETS=
GROWTH_JOB_INTERVAL_SECONDS=3600
# TWAP / iceberg scheduler (ADR-0020); 0 disables
ALGO_POLL_MS=1000
# Matching engine poll fallback (LISTEN/NOTIFY wakes it immediately).
ENGINE_POLL_MS=200

# --- Web: local `pnpm dev` only (Next.js proxies /api here). Docker uses the edge proxy. ---
API_INTERNAL_URL=http://localhost:4000

# Vault on the local test chain (ADR-0014). Development-only operator key, published on
# purpose: it holds only test ETH on the local chain (`chain deploy` funds it).
# NEVER use a raw key outside local/ci (the configuration refuses it).
CHAIN_RPC_URL=http://chain:8545
CHAIN_OPERATOR_KEY=0xc2093cb4c8e6e6555b4122d37b8b31b05e2da9b171b02cdd7c4edb3605eceabd
CHAIN_CONFIRMATIONS=2
CHAIN_FAUCET_ENABLED=true
VAULT_STATE_INTERVAL_SECONDS=60

# Phase 9 (ADR-0015). Sensitive staff actions need a fresh authenticator code.
STEP_UP_WINDOW_SECONDS=300
# Optional CIDR allow-list for staff permissions (empty = no restriction).
ADMIN_IP_ALLOWLIST=
# Isolated signer (optional locally; REQUIRED outside local/ci when the vault is on).
# SIGNER_URL=http://signer:4100
# SIGNER_HMAC_SECRET=<32+ random characters, shared with the signer>
# Grafana admin password for the local monitoring profile.
GRAFANA_ADMIN_PASSWORD=dev-only-grafana-password

